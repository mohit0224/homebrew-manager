{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "HomeBrew Manager",
	"version": "0.2.1",
	"identifier": "com.homebrew.manager",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm run build:frontend",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "HomeBrew Manager",
				"width": 1080,
				"height": 740,
				"minWidth": 950,
				"minHeight": 600,
				"center": true,
				"visible": false
			},
			{
				"label": "splashscreen",
				"title": "HomeBrew Manager",
				"url": "splash.html",
				"width": 1080,
				"height": 740,
				"center": true,
				"decorations": false,
				"resizable": false,
				"alwaysOnTop": true,
				"shadow": false,
				"transparent": true,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
