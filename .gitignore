# Environment variables
.env
.env.*
!.env.example

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Node dependencies and logs
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build outputs
dist/
dist-installer/
dist/*
build/
out/
.vite/

# Rust and Tauri build outputs
target/
**/target/
src-tauri/target/

# Editor directories
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj

# Temporary files and caches
*.tmp
*.temp
.cache/

# Ensure Agent configs, skills, and guardrails are explicitly tracked in Git
!.agents/
!.agents/skills/
!.agents/rules/
!.agents/scripts/
!.agents/hooks.json
